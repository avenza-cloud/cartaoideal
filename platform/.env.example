# Copy to .env.local (or .env) and fill in what you need. Every feature
# degrades gracefully when its variable is missing — a bare `pnpm dev` works.

# AI chat (/chat and the home-page chat). Gemini is the primary model;
# DeepSeek is the automatic fallback when the Gemini request fails to start.
# Without keys the chat UI renders but requests to /api/chat fail.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=
DEEPSEEK_API_KEY=
# Optional overrides for the DeepSeek fallback.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Canonical site URL for SEO metadata/sitemap/robots. Falls back to the
# Vercel production URL, then to the project default.
NEXT_PUBLIC_SITE_URL=

# Google AdSense (optional). Empty publisher id disables all ad slots.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=

# Community corrections → GitHub issues (optional). Both required to enable;
# otherwise POST /api/corrections returns 503 and the form reports it.
# Use a fine-grained PAT scoped to a single repo with Issues: write.
GITHUB_CORRECTIONS_TOKEN=
GITHUB_CORRECTIONS_REPO=
